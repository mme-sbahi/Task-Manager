# App
NODE_ENV=development
PORT=3001

# Database (matches docker-compose service name "postgres")
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=taskflow
DATABASE_PASSWORD=taskflow_password
DATABASE_NAME=taskflow_db

# JWT
JWT_ACCESS_SECRET=dev-only-access-secret-not-for-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-not-for-production
JWT_REFRESH_EXPIRATION=7d

# CORS — the frontend's origin
CORS_ORIGIN=http://localhost:3000                                                      
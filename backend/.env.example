# App
NODE_ENV=development
PORT=3001

# Database (matches docker-compose service name "postgres")
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=taskflow
DATABASE_PASSWORD=taskflow_password
DATABASE_NAME=taskflow_db

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRATION=7d

# CORS (frontend origin, used from Day 3 onward)
CORS_ORIGIN=http://localhost:3000

# Used only by `npm run test:e2e`. Point DATABASE_HOST at "localhost" here
# (not "postgres") since tests run on your host machine, outside the Docker
# network, connecting to Postgres through docker-compose's exposed port.
NODE_ENV=test
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=taskflow
DATABASE_PASSWORD=taskflow_password
DATABASE_NAME=taskflow_test

JWT_ACCESS_SECRET=test-access-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=test-refresh-secret
JWT_REFRESH_EXPIRATION=7d
